# Copie para .env e preencha conforme necessário. NÃO commite o .env.

# Intervalo (segundos) entre requisições para respeitar rate limit
KWAI_REQUEST_DELAY=1.5

# Timeout de requisições HTTP (segundos)
KWAI_HTTP_TIMEOUT=20

# User-Agent usado nas requisições (opcional)
KWAI_USER_AGENT=

# Diretório padrão de saída
KWAI_OUTPUT_DIR=out
